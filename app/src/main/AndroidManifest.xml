<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Networking is required for the HA integration planned in a follow-up
        PR (OkHttp REST + WebSocket per `prompts/ha.md` §4–§5). Declared
        ahead of that PR so the manifest doesn't need touching when the
        real HaClient lands. The current v1 client is `NoOpHaClient` and
        makes no network calls — this permission is dormant for now.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".IcyPowerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IcyPower"
        android:usesCleartextTraffic="true">
        <!--
            HA in v1 connects over plain HTTP to LAN servers
            (http://192.168.x.x:8123 etc.). Android 9+ blocks cleartext
            by default, so we permit it app-wide here. A future iteration
            should swap this for `android:networkSecurityConfig` with an
            explicit LAN / .local allowlist — but for a single-developer
            v1 the global flag is the lowest-friction answer.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.IcyPower"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>